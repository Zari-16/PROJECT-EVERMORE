diff --git a/src/styles/polish.css b/src/styles/polish.css
new file mode 100644
index 0000000..a657591
--- /dev/null
+++ b/src/styles/polish.css
@@ -0,0 +1,219 @@
+/* Design polish layer: loaded after index.css so it refines the existing styles.
+   Everything is driven by the theme tokens, so all six themes (light and dark) pick it up. */
+
+:root {
+  --font-body: 'Nunito Variable', 'Trebuchet MS', 'Segoe UI', sans-serif;
+  --font-display: 'Cormorant Garamond', Georgia, 'Palatino Linotype', serif;
+  --radius: 14px;
+  --radius-sm: 10px;
+  --shadow-soft: 0 1px 2px rgba(28, 20, 38, 0.05), 0 10px 28px rgba(28, 20, 38, 0.08);
+  --shadow-lift: 0 2px 4px rgba(28, 20, 38, 0.06), 0 18px 40px rgba(28, 20, 38, 0.14);
+  --ease: cubic-bezier(0.22, 0.8, 0.3, 1);
+}
+
+html {
+  background-image:
+    radial-gradient(900px 520px at 8% -8%, color-mix(in srgb, var(--primary) 22%, transparent), transparent 70%),
+    radial-gradient(800px 480px at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
+    radial-gradient(900px 600px at 50% 110%, color-mix(in srgb, var(--secondary) 18%, transparent), transparent 70%);
+  background-attachment: fixed;
+}
+
+body {
+  font-family: var(--font-body);
+  font-size: 16px;
+  line-height: 1.55;
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3 {
+  font-family: var(--font-display);
+  font-weight: 600;
+  letter-spacing: 0.005em;
+  line-height: 1.15;
+}
+
+h1 { font-size: clamp(2rem, 4.6vw, 3rem); }
+
+::selection {
+  background: color-mix(in srgb, var(--accent) 35%, transparent);
+}
+
+/* Header */
+.site-header {
+  background: color-mix(in srgb, var(--bg) 78%, transparent);
+  backdrop-filter: blur(18px) saturate(1.3);
+  box-shadow: 0 1px 0 var(--border), 0 12px 32px rgba(28, 20, 38, 0.06);
+}
+
+.site-brand-copy strong {
+  font-family: var(--font-display);
+  font-size: 1.45rem;
+  font-weight: 700;
+  letter-spacing: 0.01em;
+}
+
+.site-brand-mark {
+  background: linear-gradient(145deg, color-mix(in srgb, var(--primary) 70%, var(--surface)), var(--surface));
+  box-shadow: 0 4px 14px var(--magic), inset 0 0 0 3px color-mix(in srgb, var(--bg) 60%, transparent);
+}
+
+.site-nav-link {
+  padding: 8px 14px;
+  border-radius: 999px;
+  font-weight: 600;
+  transition: background-color 200ms var(--ease), color 200ms var(--ease), transform 200ms var(--ease);
+}
+
+.site-nav-link:hover {
+  background: color-mix(in srgb, var(--surface) 70%, var(--primary));
+  transform: translateY(-1px);
+}
+
+.site-nav-link.is-active {
+  border-color: color-mix(in srgb, var(--accent) 35%, transparent);
+  background: color-mix(in srgb, var(--accent) 14%, var(--surface));
+  box-shadow: none;
+}
+
+/* Surfaces */
+:is(
+  .card, .auth-form-panel, .home-section, .home-unpaired, .chat-panel, .daily-question,
+  .answer-form, .answers-section, .calendar-month, .calendar-selected-day, .calendar-form-section,
+  .calendar-list, .memory-form-section, .memories-library, .memory-envelope,
+  .focus-session-section, .task-form-section, .shared-tasks-list, .future-section,
+  .card-game-panel, .card-game-history, .sound-panel, .notification-panel
+) {
+  border-radius: var(--radius);
+  border-color: color-mix(in srgb, var(--accent) 16%, var(--border));
+  background: color-mix(in srgb, var(--surface) 88%, transparent);
+  box-shadow: var(--shadow-soft);
+  backdrop-filter: blur(8px);
+}
+
+:is(.home-section, .calendar-list, .memory-envelope, .game-library-item) {
+  transition: transform 260ms var(--ease), box-shadow 260ms var(--ease), border-color 260ms var(--ease);
+}
+
+:is(.home-section, .calendar-list, .memory-envelope, .game-library-item):hover {
+  border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
+  box-shadow: var(--shadow-lift), 0 0 28px var(--magic);
+  transform: translateY(-2px);
+}
+
+.home-welcome {
+  position: relative;
+  overflow: hidden;
+  padding: clamp(24px, 4vw, 40px);
+  border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
+  border-left-width: 1px;
+  border-radius: calc(var(--radius) + 6px);
+  background:
+    radial-gradient(520px 220px at 90% -20%, color-mix(in srgb, var(--primary) 30%, transparent), transparent 70%),
+    linear-gradient(120deg, var(--surface), color-mix(in srgb, var(--surface) 72%, var(--primary)));
+  box-shadow: var(--shadow-soft), 0 0 40px var(--magic);
+}
+
+.home-welcome h1 {
+  font-size: clamp(2.2rem, 5vw, 3.4rem);
+}
+
+.home-eyebrow {
+  letter-spacing: 0.16em;
+  font-size: 0.74rem;
+}
+
+/* Controls */
+button {
+  min-height: 40px;
+  padding: 8px 16px;
+  border-radius: var(--radius-sm);
+  font-weight: 600;
+  transition: transform 180ms var(--ease), box-shadow 180ms var(--ease), background-color 180ms var(--ease), border-color 180ms var(--ease);
+}
+
+button:not(:disabled):hover {
+  box-shadow: 0 6px 16px var(--magic);
+  transform: translateY(-1px);
+}
+
+button:not(:disabled):active {
+  box-shadow: none;
+  transform: translateY(1px) scale(0.98);
+}
+
+button[type="submit"]:not(.site-signout) {
+  border-color: transparent;
+  background: linear-gradient(135deg, var(--primary), var(--accent));
+  color: #fff;
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
+  box-shadow: 0 6px 18px color-mix(in srgb, var(--accent) 35%, transparent);
+}
+
+button[type="submit"]:not(:disabled):not(.site-signout):hover {
+  background: linear-gradient(135deg, color-mix(in srgb, var(--primary) 88%, #fff), color-mix(in srgb, var(--accent) 88%, #fff));
+}
+
+input:not([type="color"]):not([type="range"]),
+select,
+textarea {
+  border-radius: var(--radius-sm);
+  background: color-mix(in srgb, var(--bg) 70%, var(--surface));
+  transition: border-color 180ms var(--ease), box-shadow 180ms var(--ease);
+}
+
+input:not([type="color"]):not([type="range"]):focus,
+select:focus,
+textarea:focus {
+  border-color: var(--accent);
+  box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent);
+  outline: none;
+}
+
+:focus-visible {
+  outline: 3px solid color-mix(in srgb, var(--accent) 45%, transparent);
+  outline-offset: 2px;
+}
+
+input[type="range"] { accent-color: var(--accent); }
+
+/* Game boards and canvases */
+:is(.sudoku-board, .snake-board, .ludo-board-wrap, .whiteboard-canvas, .home-board-preview) {
+  border-radius: var(--radius);
+  box-shadow: var(--shadow-soft), 0 0 30px var(--magic);
+}
+
+/* Chat */
+.chat-message {
+  border-radius: 16px;
+  box-shadow: 0 2px 8px rgba(28, 20, 38, 0.06);
+}
+
+/* Scrollbars */
+* {
+  scrollbar-width: thin;
+  scrollbar-color: color-mix(in srgb, var(--accent) 40%, transparent) transparent;
+}
+
+/* Page transitions */
+@keyframes realm-arrive {
+  from { opacity: 0; transform: translateY(12px) scale(0.995); }
+  to { opacity: 1; transform: none; }
+}
+
+.app-route-content > * {
+  animation-duration: 420ms;
+  animation-timing-function: var(--ease);
+}
+
+@media (max-width: 720px) {
+  .site-nav-link { padding: 7px 11px; font-size: 0.86rem; }
+  .home-welcome { padding: 22px 18px; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after {
+    animation-duration: 1ms !important;
+    transition-duration: 1ms !important;
+  }
+}
